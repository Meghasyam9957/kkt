# Names only — never commit real values.
#
# Credentials are namespaced by environment. DEMO reads only DEMO_*; PRODUCTION reads only
# PRODUCTION_*. That is what makes the isolation structural: a demo deployment has no code
# path that looks at a PRODUCTION_ variable, so it cannot reach the real workbook or the
# real Supabase project even by mistake.

# ---- Which system is this? ----
# demo | production. Unset comes up as demo, deliberately: coming up as production by
# accident is a data incident, coming up as demo is an inconvenience.
APP_ENV=demo

# true reads the environment's workbook; false serves the generated demo dataset.
# PRODUCTION requires true — it has no fixture mode at all.
LIVE_DATA_ENABLED=false

# Read-cache TTL. Clamped to 5..600 seconds by lib/server/cache/read-cache.ts.
SHEETS_CACHE_TTL_SECONDS=90

# ---- DEMO / UAT ----
DEMO_GOOGLE_SHEET_ID=
DEMO_GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
DEMO_SUPABASE_URL=
DEMO_SUPABASE_SERVICE_ROLE_KEY=
DEMO_SUPABASE_ANON_KEY=
DEMO_SUPABASE_AUTH_COOKIE=

# Where the demo seed snapshot lives (captured by `npm run demo:snapshot`; restored by
# the admin-only demo reset). Default: .demo/seed-snapshot.json under the project root.
DEMO_SEED_SNAPSHOT_PATH=

# Passwords for the Phase D real-demo browser suite (e2e/real-demo.spec.ts) when the
# demo Supabase project is configured. Session-environment only — never put real values
# in a file. The values come from `node scripts/demo-users.mjs`.
DEMO_E2E_ADMIN_PASSWORD=
DEMO_E2E_OPERATIONS_PASSWORD=
DEMO_E2E_INVESTOR_A_PASSWORD=
DEMO_E2E_INVESTOR_B_PASSWORD=

# ---- AI (ARCHITECTURE §8) ----
# Namespaced like everything else: a DEMO key is a different variable from a PRODUCTION
# key and neither can stand in for the other. Every one of these is absent by default, and
# each absence is a named refusal rather than a default — `aiProviderPermitted` says which.
#
# NEVER put a real key in this file or any tracked file. Set it in the deployment's secret
# configuration, by the person who owns the credential.
#
# Use a PROJECT-scoped key (sk-proj-...). OpenAI recommends separate projects so usage,
# rate limits and spend can be attributed and capped per project rather than per account.

# Literal 'true' enables the integration. Anything else — including unset — leaves it off.
DEMO_AI_ENABLED=
# Which adapter: 'openai' for the real provider, 'mock' for the deterministic local one.
DEMO_AI_PROVIDER=
DEMO_OPENAI_API_KEY=
# The model id, from config so it can change without a deploy (§8.4). No id is hard-coded.
DEMO_AI_MODEL_COPILOT=

# Pricing, in the unit OpenAI publishes: per MILLION tokens. Converted to the internal
# per-token contract in one place, with a test pinning the conversion. Copying a published
# figure into a per-token field is a millionfold error, which is why the unit is in the name.
DEMO_AI_PRICE_INPUT_PER_MTOK=
DEMO_AI_PRICE_CACHED_INPUT_PER_MTOK=
DEMO_AI_PRICE_OUTPUT_PER_MTOK=

# The currency the PROVIDER bills in, and the currency the BUDGET is expressed in. If they
# differ the call is refused rather than converted: an exchange-rate policy is a management
# decision, not something this application invents.
DEMO_AI_PRICE_CURRENCY=
DEMO_AI_BUDGET_CURRENCY=
# The approved monthly cap (§13 Q6). Absent means UNCONFIGURED, which refuses every call —
# never "unlimited".
DEMO_AI_BUDGET_CAP=

# Production begins disabled and stays disabled until this is literally 'true', mirroring
# PRODUCTION_WRITES_ENABLED. Note this is NECESSARY BUT NOT SUFFICIENT: production also has
# nowhere durable to accumulate spend, so a hard cap cannot be enforced there and the
# provider is refused regardless. See docs/DECISIONS_REQUIRED.md.
PRODUCTION_AI_PRODUCTION_APPROVED=

# ---- PRODUCTION ----
PRODUCTION_GOOGLE_SHEET_ID=
PRODUCTION_GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
PRODUCTION_SUPABASE_ANON_KEY=
PRODUCTION_SUPABASE_AUTH_COOKIE=

# ---- LIVE parity harness ----
# A third, separate workbook: a COPY, never demo and never production. Read by the parity
# suite and its preflight only — the application never reads these.
#
# The names are parity-specific on purpose. A deployment script that sets GOOGLE_SHEET_ID
# cannot point the parity harness at a live workbook by accident, and the preflight
# REFUSES to run if this id matches DEMO_GOOGLE_SHEET_ID or PRODUCTION_GOOGLE_SHEET_ID.
PARITY_SHEET_ID=

# The service-account credential, in ONE of two forms:
#   PARITY_SERVICE_ACCOUNT_FILE        path to the downloaded key.json  ← easier on Windows
#   PARITY_SERVICE_ACCOUNT_JSON_BASE64 the same file, base64-encoded    ← for CI secrets
# Put key.json OUTSIDE this repository. It is a password in a file.
PARITY_SERVICE_ACCOUNT_FILE=
PARITY_SERVICE_ACCOUNT_JSON_BASE64=

# Set to yes ONLY if the parity copy genuinely cannot be renamed to say PARITY / COPY /
# TEST. Recorded in the parity report when used.
PARITY_TITLE_CONFIRMED_NOT_PRODUCTION=

# Legacy names, still accepted so an existing setup keeps working.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
